{
  "name": "@abrahamahn/realtime-core",
  "version": "0.3.2",
  "description": "Transport-neutral realtime delivery, recovery, subscription, retry, and liveness state",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Abraham Joongwhan Ahn",
  "repository": {
    "type": "git",
    "url": "https://github.com/abrahamahn/realtime-core.git",
    "directory": "typescript"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "type-check": "pnpm typecheck",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "prepack": "pnpm build && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.26.2"
}
